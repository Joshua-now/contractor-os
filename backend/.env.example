# Contractor-OS Backend Environment Variables
# Copy this file to .env and fill in your values

# ─── SERVER ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── DATABASE ────────────────────────────────────────────
# Automatically set by Railway when you add a Postgres service:
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── LLM PROVIDER ────────────────────────────────────────
# Choose your AI brain provider: 'openrouter' (default) | 'anthropic'
LLM_PROVIDER=openrouter

# ─── OPENROUTER (Recommended — access 100+ models via one API) ───
# Get your key at: openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Which model to use. Examples:
#   anthropic/claude-sonnet-4-5       (Claude via OpenRouter)
#   openai/gpt-4o                     (GPT-4o)
#   google/gemini-pro                 (Gemini Pro)
#   meta-llama/llama-3.1-8b-instruct  (Free open-source)
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# ─── ANTHROPIC DIRECT (Fallback / alternative to OpenRouter) ─────
# Used if LLM_PROVIDER=anthropic, or as fallback if OpenRouter fails
# Get your key at: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# ─── TWILIO (Primary SMS/Voice — or use as fallback) ─────
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# ─── TELNYX (Alternative SMS/Voice provider) ─────────────
# Get these from telnyx.com → API Keys
TELNYX_API_KEY=KEY0123456789ABCDEFGH
TELNYX_PHONE_NUMBER=+15559876543
TELNYX_PUBLIC_KEY=your_telnyx_ed25519_public_key
TELNYX_CONNECTION_ID=your_telnyx_sip_connection_id
TELNYX_MESSAGING_PROFILE_ID=your_telnyx_messaging_profile_id
SMS_PROVIDER=twilio

# ─── GOHIGHLEVEL CRM ─────────────────────────────────────
GHL_API_KEY=your_ghl_api_key
GHL_LOCATION_ID=your_ghl_location_id

# ─── FRONTEND ────────────────────────────────────────────
# Set this after frontend deploys on Railway
FRONTEND_URL=https://your-frontend.up.railway.app
